# Copie para .env.local e preencha. Nunca faça commit do arquivo preenchido.
# Primeiros passos: npm install · npm run verificar -- ambiente · npm run db:migrate · npm run dev
# Homologação com os serviços reais: docs/roteiro-homologacao.md (npm run verificar -- <passo>)
# Pode ficar em .env ou .env.local (o .env.local prevalece). Variáveis já definidas no terminal valem mais que os arquivos.
# Obrigatórias em produção: TURSO_*, OPENWA_*, ADMIN_WHATSAPP_NUMBER, CRM_USUARIO/CRM_SENHA, ANTHROPIC_API_KEY, RESEND_*

# --- Banco (Turso / libSQL) ---
# Remoto: libsql://<banco>-<org>.turso.io   |   Local de desenvolvimento: file:local.db
TURSO_DATABASE_URL=
# Token gerado com: turso db tokens create <banco>   (dispensado quando a URL é file:)
# (A integração Turso da Vercel cria TURSO_DATABASE_AUTH_TOKEN; o sistema aceita os dois nomes.)
TURSO_AUTH_TOKEN=

# --- WhatsApp (OpenWA) ---
# Endereço do servidor OpenWA, sem barra no fim. Ex.: https://openwa.seudominio.com.br
OPENWA_BASE_URL=
# Chave de API do OpenWA (cabeçalho X-API-Key)
OPENWA_API_KEY=
# Id da sessão do OpenWA conectada ao número do bot. Ex.: crm-bot
OPENWA_SESSION_ID=
# Opcional: tempo máximo de um envio ao OpenWA (ms, padrão 8000; cabe no orçamento da Vercel).
OPENWA_TIMEOUT_MS=
# Mesmo valor do campo "secret" ao cadastrar o webhook no OpenWA (assinatura HMAC). Obrigatório.
# Gere um valor aleatório longo, ex.: openssl rand -hex 32
OPENWA_WEBHOOK_SECRET=
# No servidor OpenWA (não aqui): RESOLVE_LID_TO_PHONE=true, para mensagens de contatos com
# privacy id (@lid) chegarem com o telefone.

# --- Aprovação humana pré-CRM ---
# WhatsApp do consultor que aprova os leads (só dígitos, com DDI). Ex.: 5511999999999
# Precisa ser um número diferente do número do bot.
ADMIN_WHATSAPP_NUMBER=

# --- Modo piloto (opcional; desligado por padrão) ---
# Com PILOTO_ATIVO=true, a IA só atende contato NOVO que chegou pelo site (mensagem com a frase
# do formulário ou do botão do WhatsApp) ou que esteja na lista de teste. Outras conversas do chip
# são ignoradas sem gravar nada. Quem já é contato segue normalmente.
PILOTO_ATIVO=
# Números de teste (só dígitos, com DDI), separados por vírgula. Ex.: 5511999999999,5521988888888
PILOTO_NUMEROS_TESTE=
# Frase que identifica quem veio do site (sem diferença de acento ou maiúscula). Padrão: quero um diagnostico
PILOTO_GATILHO=

# --- Área do cliente (login do site) ---
# Segredo das sessões, 32+ caracteres aleatórios: openssl rand -base64 32. Obrigatório em produção.
BETTER_AUTH_SECRET=
# Endereço público do site, sem barra no fim. Ex.: https://letstouchbase.com.br
BETTER_AUTH_URL=
# Login com o Google (opcional; sem as duas, o botão do Google não aparece).
# Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth (aplicativo da Web).
# URI de redirecionamento autorizado: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Acesso do consultor ao CRM (Kanban e API de leads) ---
# Usuário e senha pedidos pelo navegador. Sem eles, o painel fica bloqueado.
CRM_USUARIO=
CRM_SENHA=

# --- IA do diagnóstico (Claude, da Anthropic) ---
# Chave da API (console.anthropic.com > API Keys). Ex.: sk-ant-...
# Sem ela, o bot não responde: a mensagem fica salva, o contato é pausado e o consultor é avisado.
ANTHROPIC_API_KEY=
# Opcionais: modelo (padrão claude-sonnet-5-5, rápido e econômico; claude-opus-5-5 é o mais capaz)
# e esforço (padrão low; low, medium, high).
AGENTE_MODELO=
AGENTE_ESFORCO=
# Opcionais: tempo máximo de cada chamada à IA (ms, padrão 18000) e novas tentativas (padrão 1).
# Os padrões cabem nos 60 s da rota do webhook na Vercel. Em VPS pode aumentar (ex.: 45000 e 2).
AGENTE_TIMEOUT_MS=
AGENTE_TENTATIVAS_EXTRAS=
# Opcional: campos mínimos para encerrar o diagnóstico, separados por vírgula.
# Vazio = mínimo viável: nome_ou_razao_social,documento,descricao_negocio,volume_mensal,metodos_pagamento
# (os demais pontos são perguntados uma vez; sem resposta, ficam "Não informado / A apurar").
DIAGNOSTICO_OBRIGATORIOS=

# --- Dashboard ---
# Meta de lucro líquido mensal da consultoria, em reais. Padrão: 25000
META_LUCRO_MENSAL=

# --- E-mail (Resend) ---
# Chave da API do Resend (resend.com > API Keys), com permissão de envio. Ex.: re_...
RESEND_API_KEY=
# Remetente dos e-mails. O domínio precisa estar verificado no Resend, senão o envio é recusado.
# Ex.: Comercial <comercial@seudominio.com.br>
RESEND_FROM_EMAIL=
