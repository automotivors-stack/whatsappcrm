# Copie para .env.local e preencha. Nunca faça commit do arquivo preenchido.

# --- Banco (Turso / libSQL) ---
# Remoto: libsql://<banco>-<org>.turso.io   |   Local de desenvolvimento: file:local.db
TURSO_DATABASE_URL=
# Token gerado com: turso db tokens create <banco>   (dispensado quando a URL é file:)
TURSO_AUTH_TOKEN=

# --- WhatsApp (OpenWA) ---
# Endereço do servidor OpenWA, sem barra no fim. Ex.: https://openwa.seudominio.com.br
OPENWA_BASE_URL=
# Chave de API do OpenWA (cabeçalho X-API-Key)
OPENWA_API_KEY=
# Id da sessão do OpenWA conectada ao número do bot
OPENWA_SESSION_ID=
# Mesmo valor do campo "secret" ao cadastrar o webhook no OpenWA (assinatura HMAC). Obrigatório.
OPENWA_WEBHOOK_SECRET=
# No servidor OpenWA (não aqui): RESOLVE_LID_TO_PHONE=true, para mensagens de contatos com
# privacy id (@lid) chegarem com o telefone.

# --- Aprovação humana pré-CRM ---
# WhatsApp do consultor que aprova os leads (só dígitos, com DDI). Ex.: 5511999999999
ADMIN_WHATSAPP_NUMBER=

# --- E-mail (Resend) --- usados a partir da fase de envio de e-mail
RESEND_API_KEY=
RESEND_FROM_EMAIL=
